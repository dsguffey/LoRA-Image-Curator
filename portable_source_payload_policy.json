{
  "schema_version": 1,
  "purpose": "Slim end-user source distribution boundary",
  "artifact_name_template": "LoRA_Image_Curator_Portable_Source_v{version}.zip",
  "include_all_manifested_top_level_python": true,
  "included_files": [
    "PORTABLE_README.txt",
    "LICENSE",
    "MODEL_LICENSES.txt",
    "THIRD_PARTY_NOTICE.md",
    "provider_registry.json",
    "SBOM.spdx.json",
    "VERSION.txt",
    "Run LoRA Image Curator.bat",
    "Run LoRA Image Curator - Diagnostic.bat",
    "Setup and Launch LoRA Image Curator.bat",
    "requirements.txt",
    "requirements-body.txt"
  ],
  "archive_name_overrides": {
    "PORTABLE_README.txt": "README.txt"
  },
  "required_archive_files": [
    "README.txt",
    "LICENSE",
    "MODEL_LICENSES.txt",
    "THIRD_PARTY_NOTICE.md",
    "provider_registry.json",
    "SBOM.spdx.json",
    "VERSION.txt",
    "RELEASE_MANIFEST.sha256",
    "Run LoRA Image Curator.bat",
    "Run LoRA Image Curator - Diagnostic.bat",
    "Setup and Launch LoRA Image Curator.bat",
    "requirements.txt",
    "requirements-body.txt",
    "app.py",
    "setup_assistant.py"
  ],
  "excluded_directories": [
    ".git",
    ".github",
    ".pytest_cache",
    "__pycache__",
    "tests",
    "tools",
    "docs",
    "venv",
    ".venv",
    "dependency_backups",
    "release_audit",
    "release_output",
    "output",
    "models",
    "thumbnail_cache",
    "datasets",
    "image_sources",
    "video_frames",
    "exports",
    "quarantine",
    "Old Files to be trashed"
  ],
  "excluded_repository_files": [
    ".gitattributes",
    ".gitignore",
    "BUGS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DESIGN_PHILOSOPHY.md",
    "FACE_ANALYSIS.md",
    "GIT_READY_CHECKLIST.md",
    "PHASE1_AUDIT.md",
    "PRE1_RELEASE_AUDIT.md",
    "README.md",
    "ROADMAP.md",
    "SECURITY.md",
    "WISHLIST.md",
    "pyproject.toml",
    "requirements-face.txt",
    "portable_payload_policy.json",
    "portable_source_payload_policy.json",
    "Run LoRA Image Curator.vbs",
    "Install Base Dependencies.bat",
    "Install Body Analysis Dependencies.bat",
    "Install Face Analysis Dependencies.bat",
    "Check Face Analysis Setup.bat"
  ],
  "never_collect_patterns": [
    "*.db",
    "*.sqlite*",
    "*.log",
    "*.onnx",
    "*.safetensors",
    "*.ckpt",
    "*.pt",
    "*.pth",
    "*.zip",
    "*.pem",
    "*.key",
    ".env*",
    "settings.json"
  ],
  "runtime_rule": "This source-based package does not bundle Python, a virtual environment, wheels, models, or FFmpeg. Guided setup creates a clean adjacent venv after the user explicitly chooses setup actions.",
  "provider_rule": "Checks never download components. Model, package, and tool acquisition remains explicit and follows the release-owned provider registry and setup workflow."
}
