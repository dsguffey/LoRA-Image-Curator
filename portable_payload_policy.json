{
  "schema_version": 1,
  "purpose": "End-user portable Windows payload boundary",
  "artifact_name_template": "LoRA_Image_Curator_Portable_Windows_x64_v{version}.zip",
  "source_artifact_name_template": "LoRA_Image_Curator_Source_v{version}.zip",
  "required_user_files": [
    "LICENSE",
    "MODEL_LICENSES.txt",
    "THIRD_PARTY_NOTICE.md",
    "provider_registry.json",
    "SBOM.spdx.json",
    "Run LoRA Image Curator.bat",
    "Run LoRA Image Curator - Diagnostic.bat"
  ],
  "excluded_directories": [
    ".git",
    ".github",
    "tests",
    "tools",
    "docs",
    "venv",
    ".venv",
    "dependency_backups",
    "release_audit",
    "release_output",
    "output",
    "models",
    "thumbnail_cache",
    "datasets",
    "image_sources",
    "video_frames",
    "exports",
    "quarantine",
    "Old Files to be trashed"
  ],
  "excluded_source_only_files": [
    ".gitattributes",
    ".gitignore",
    "CONTRIBUTING.md",
    "DESIGN_PHILOSOPHY.md",
    "GIT_READY_CHECKLIST.md",
    "PHASE1_AUDIT.md",
    "PRE1_RELEASE_AUDIT.md",
    "pyproject.toml",
    "requirements.txt",
    "requirements-body.txt",
    "requirements-face.txt",
    "setup_assistant.py",
    "Install Base Dependencies.bat",
    "Install Body Analysis Dependencies.bat",
    "Install Face Analysis Dependencies.bat",
    "Check Face Analysis Setup.bat"
  ],
  "never_collect_patterns": [
    "*.db",
    "*.sqlite*",
    "*.log",
    "*.onnx",
    "*.safetensors",
    "*.ckpt",
    "*.pt",
    "*.pth",
    "settings.json"
  ],
  "runtime_rule": "The portable build receives a clean private runtime staged by the release build; it never copies a developer or user venv.",
  "provider_rule": "Only explicitly approved redistributable assets may be bundled; large, restricted, or hardware-specific components remain verified optional packs/downloads."
}
