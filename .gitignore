# Python and test artifacts
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Local environments and dependency snapshots
venv/
.venv/
env/
dependency_backups/

# User data: never commit catalogs, images, provider output, or local state
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
*.partial.csv
settings.json
thumbnail_cache/
output/
datasets/
image_sources/
video_frames/
quarantine/

# Raw dataset media is private by default. Curated, permission-safe public
# screenshots may be committed deliberately beneath docs/assets.
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.avif
*.heic
*.mp4
*.mkv
*.mov
*.avi
*.webm
!docs/assets/**

# Models and large generated artifacts
*.onnx
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
models/

# Local secrets and machine-specific environment configuration
.env
.env.*
!.env.example

# Releases, exports, and local QA material
*.zip
release_audit/
release_output/
exports/
catalog_backups/

# IDE and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
